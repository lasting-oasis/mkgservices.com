rules_version = '2';

// Who can read and write what. Deployed with the site (see docs/SETUP-firebase.md).
//
//   requests/{id}   one quote request; customer details inside. Anyone can
//                   create one; only the owner (admin) and the customer who
//                   sent it (signed in with the same email) can read it;
//                   the admin can change anything, the customer can only
//                   move or cancel it while it is new or confirmed.
//   holds/{id}      a date + time window a request is holding. No customer
//                   details, so anyone can read them: that is how the public
//                   calendar shows which windows are taken.
//   days/{date}     days off and blocked windows, set by the admin.
//   admins/{uid}    one document per admin account. The owner's is created by
//                   hand in the console (role: 'owner'); everyone else's is
//                   created by the site the first time an invited person
//                   signs in.
//   adminInvites/{email}  an email the owner has invited onto the team.
//   shifts/{id}     one clock-in/clock-out by a team member, optionally tied
//                   to the request (job) they worked on.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasAdminDoc() { return exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function myEmail() { return request.auth.token.email.lower(); }
    // Invited by email and signed in with a provider that verified that email (Google).
    function invited() {
      return signedIn() && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/adminInvites/$(myEmail()));
    }
    function isAdmin() { return signedIn() && (hasAdminDoc() || invited()); }
    // The owner runs the team: the one admin document with role 'owner'.
    function isTeamOwner() {
      return signedIn() && hasAdminDoc() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function shortText(s, n) { return s is string && s.size() <= n; }
    // The signed-in customer whose email is on the document being read/changed.
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true &&
        resource.data.emailLower == request.auth.token.email.lower();
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function ownsRequest(requestId) {
      return signedIn() && request.auth.token.email_verified == true && requestId != 'manual' &&
        get(/databases/$(database)/documents/requests/$(requestId)).data.emailLower == request.auth.token.email.lower();
    }

    match /requests/{id} {
      allow create: if
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time &&
        shortText(request.resource.data.name, 120) && request.resource.data.name.size() > 0 &&
        shortText(request.resource.data.email, 200) && request.resource.data.email.size() > 3 &&
        request.resource.data.emailLower == request.resource.data.email.lower() &&
        shortText(request.resource.data.phone, 40) &&
        shortText(request.resource.data.notes, 2000) &&
        shortText(request.resource.data.zip, 10) &&
        (request.resource.data.date == '' || isDate(request.resource.data.date)) &&
        shortText(request.resource.data.slot, 10) &&
        request.resource.data.segment in ['residential', 'commercial'] &&
        request.resource.data.keys().size() <= 40;
      allow read: if isAdmin() || isOwner();
      // The customer who sent a request may, while it is still new or
      // confirmed, move it to another day/window or cancel it. Nothing else.
      allow update: if isAdmin() || (isOwner() && resource.data.status in ['new', 'confirmed'] && (
        (changed().hasOnly(['date', 'slot', 'updatedAt']) &&
          (request.resource.data.date == '' || isDate(request.resource.data.date)) &&
          shortText(request.resource.data.slot, 10)) ||
        (changed().hasOnly(['status', 'cancelledBy', 'updatedAt']) &&
          request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == 'client')
      ));
      allow delete: if isAdmin();
    }

    match /holds/{id} {
      allow read: if true;
      // A visitor may hold a window only together with the request it belongs
      // to (same batch), and the request must name the same date and window.
      allow create: if isAdmin() || (
        isDate(request.resource.data.date) &&
        shortText(request.resource.data.slot, 10) && request.resource.data.slot.size() > 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.requestId is string &&
        request.resource.data.keys().hasOnly(['date', 'slot', 'requestId', 'createdAt', 'segment']) &&
        getAfter(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.date == request.resource.data.date &&
        getAfter(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.slot == request.resource.data.slot
      );
      allow update: if isAdmin();
      // A customer may drop their own hold (when moving or cancelling the request).
      allow delete: if isAdmin() || ownsRequest(resource.data.requestId);
    }

    match /days/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // An invited person registers themselves on first sign-in; nobody else
      // can create one from the site (the owner's is made in the console).
      allow create: if signedIn() && request.auth.uid == uid && invited() &&
        request.resource.data.email == myEmail() && request.resource.data.role == 'admin' &&
        request.resource.data.keys().hasOnly(['email', 'role', 'createdAt']);
      allow update: if false;
      allow delete: if isTeamOwner() && resource.data.role != 'owner' && request.auth.uid != uid;
    }

    match /shifts/{id} {
      // A member sees and writes their own shifts; the owner sees, fixes, and deletes everyone's.
      allow read: if isTeamOwner() || (isAdmin() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == myEmail() &&
        request.resource.data.inAt == request.time && request.resource.data.outAt == null &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'inAt', 'outAt', 'requestId', 'note']);
      allow update: if isTeamOwner() ||
        (isAdmin() && resource.data.uid == request.auth.uid && changed().hasOnly(['outAt', 'requestId', 'note']) &&
         (request.resource.data.outAt == null || request.resource.data.outAt == request.time));
      allow delete: if isTeamOwner();
    }

    match /adminInvites/{email} {
      allow read: if isAdmin();
      allow create: if isTeamOwner() && email == email.lower() && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.email == email && request.resource.data.keys().hasOnly(['email', 'invitedBy', 'createdAt']);
      allow update: if false;
      allow delete: if isTeamOwner();
    }
  }
}
